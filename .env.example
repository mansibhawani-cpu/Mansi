# Neon Postgres (serverless)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Resend (for transactional emails: invitation, reminder, confirmation, updates)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Youth Inspiration Summit <hello@yourdomain.com>"

# Cloudinary (for speaker photos, sponsor logos – no AI generation)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Super Admin secret (simple protection for /admin/setup)
ADMIN_SECRET="change-this-to-a-strong-secret"

# Optional: Vercel URL (auto-set on Vercel)
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
